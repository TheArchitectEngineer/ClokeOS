diff -ruN webkitgtk-2.54.2/Source/WTF/wtf/generic/MemoryFootprintGeneric.cpp webkitgtk-2.54.2/Source/WTF/wtf/generic/MemoryFootprintGeneric.cpp
--- webkitgtk-2.54.2/Source/WTF/wtf/generic/MemoryFootprintGeneric.cpp	2026-07-24 10:02:54
+++ webkitgtk-2.54.2/Source/WTF/wtf/generic/MemoryFootprintGeneric.cpp	2026-10-29 09:23:09
@@ -28,13 +28,25 @@
 #include <wtf/AvailableMemory.h>
 #include <wtf/MemoryFootprint.h>
 #include <wtf/Platform.h>
+#if defined(CLOKEOS_PD)
+#include <mach/mach.h>
+#endif
 
 namespace WTF {
 
 size_t memoryFootprint()
 {
+#if defined(CLOKEOS_PD)
+    // ClokeOS (PureDarwin): Mach statt /proc
+    task_vm_info_data_t info;
+    mach_msg_type_number_t count = TASK_VM_INFO_COUNT;
+    if (task_info(mach_task_self(), TASK_VM_INFO, reinterpret_cast<task_info_t>(&info), &count) != KERN_SUCCESS)
+        return 0;
+    return static_cast<size_t>(info.phys_footprint);
+#else
     auto memoryUse = memoryStatus();
     return memoryUse.memoryFootprint;
+#endif
 }
 
 } // namespace WTF
