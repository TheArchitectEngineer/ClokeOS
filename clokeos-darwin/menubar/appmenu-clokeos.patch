+/* ClokeOS: erstes GtkAccelLabel im Menüeintrag (auch in einer Box mit Symbol) */
+static GtkAccelLabel *find_accel_label(GtkWidget *widget)
+{
+	if (GTK_IS_ACCEL_LABEL(widget))
+		return GTK_ACCEL_LABEL(widget);
+
+	if (GTK_IS_CONTAINER(widget))
+	{
+		GList *children = gtk_container_get_children(GTK_CONTAINER(widget));
+		GtkAccelLabel *found = NULL;
+
+		for (GList *iter = children; iter != NULL && found == NULL; iter = g_list_next(iter))
+			found = find_accel_label(iter->data);
+
+		g_list_free(children);
+		return found;
+	}
+
+	return NULL;
+}
