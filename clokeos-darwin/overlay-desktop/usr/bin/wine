#!/bin/sh
# ClokeOS: Startskript für Wine (PureDarwins Wine 11.0, WoW64, X11-Treiber).
#   - Laufwerk C: ist /NT, der Windows-Systemordner von ClokeOS (/NT/Windows, /NT/Program Files, ...)
#   - der Prefix (Registry, Laufwerke) liegt je Benutzer in ~/Library/Wine
#   - wineboot, winecfg, winefile, ... sind Verknüpfungen auf dieses Skript und starten das gleichnamige Programm
for real in /usr/lib/wine/*-unix/wine; do :; done
[ -x "$real" ] || { echo "wine: auf dieser Architektur nicht installiert" >&2; exit 127; }
name=${0##*/}
[ "$name" = wine ] || set -- "$name" "$@"
case "$1" in --version|--help|-h) exec "$real" "$@" ;; esac

: "${WINEPREFIX:=$HOME/Library/Wine}"
: "${WINEDEBUG:=fixme-all}"
: "${DISPLAY:=:0}"
# Kein Menü-Eintrag-Erzeuger (winemenubuilder braucht xdg-utils), kein Mono/Gecko-Download
: "${WINEDLLOVERRIDES:=winemenubuilder.exe=d;mscoree,mshtml=d}"
export WINEPREFIX WINEDEBUG DISPLAY WINEDLLOVERRIDES

# Erster Start eines Benutzers: C: auf /NT zeigen lassen, bevor Wine den Prefix anlegt
if [ ! -e "$WINEPREFIX/system.reg" ] && [ -d /NT ] && [ -w /NT ]; then
  mkdir -p "$WINEPREFIX/dosdevices"
  [ -e "$WINEPREFIX/drive_c" ] || [ -h "$WINEPREFIX/drive_c" ] || ln -s /NT "$WINEPREFIX/drive_c"
  [ -e "$WINEPREFIX/dosdevices/c:" ] || [ -h "$WINEPREFIX/dosdevices/c:" ] || ln -s ../drive_c "$WINEPREFIX/dosdevices/c:"
  echo "wine: richte die Windows-Umgebung ein (nur beim ersten Start, das dauert)" >&2
fi
exec "$real" "$@"
