#!/bin/zsh
# Aktivitätsanzeige aus dem Dock: Prozesse nach Rechenzeit, alle zwei Sekunden neu.
trap 'exit 0' INT
while true; do
  print -n '\033[H\033[2J'
  print -P "%B Aktivitätsanzeige%b   $(hostname)   $(date +%H:%M:%S)   $(sysctl -n hw.ncpu) Kern(e)"
  print
  ps -axo pid,pcpu,pmem,rss,comm -r | head -n 28
  sleep 2
done
