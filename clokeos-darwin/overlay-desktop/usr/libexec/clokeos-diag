#!/bin/zsh
# Diagnose für Rechner, an denen Tastatur oder Maus nicht gehen: zeigt in einem Fenster, was ClokeOS
# von der Hardware sieht, zum Abfotografieren. cloakserver-session startet es, wenn 45 Sekunden nach
# dem Start weder /dev/usb_hid_kbd noch /dev/usb_hid_mouse da sind; Xorg liest Eingaben nur von dort
# (puredarwininput), eingebaute PS/2-Tastaturen und Touchpads von Notebooks erreichen es nicht.
#   clokeos-diag          Bericht ausgeben
PATH=/bin:/sbin:/usr/bin:/usr/sbin
. /etc/clokeos-release 2>/dev/null
prop() { # Zeichenkette aus ioreg: "name" = <"Wert"> oder "name" = "Wert"
  sed -n -E "s/.*\"$1\" = <?\"([^\"]*)\".*/\1/p" | head -1
}
pe=$(ioreg -c IOPlatformExpertDevice -d 2 -w 0 2>/dev/null)
print "ClokeOS ${VERSION:-?} ($(uname -m)) - no USB keyboard or mouse found. Please take a photo of this window."
print "Model: $(print -r -- $pe | prop manufacturer) $(print -r -- $pe | prop product-name) $(print -r -- $pe | prop model)  RAM: $(( $(sysctl -n hw.memsize) / 1048576 )) MB"
print
print "PCI devices (vendor:device class -> driver):"
ioreg -r -c IOPCIDevice -d 2 -l -w 0 2>/dev/null | awk '
  function le16(s) { return substr(s, 3, 2) substr(s, 1, 2) }
  function flush() { if (name != "") printf "  %-24s %s:%s %s -> %s\n", name, vid, did, cls, (drv == "" ? "NO DRIVER" : drv) }
  /\+-o .*<class IOPCIDevice/ { flush(); name = $0; sub(/.*\+-o /, "", name); sub(/ .*/, "", name); vid = did = cls = drv = ""; next }
  /\+-o / { if (drv == "") { d = $0; sub(/.*\+-o /, "", d); sub(/ .*/, "", d); drv = d }; next }
  /"vendor-id" = </ && vid == "" { v = $0; sub(/.*= </, "", v); vid = le16(v) }
  /"device-id" = </ && did == "" { v = $0; sub(/.*= </, "", v); did = le16(v) }
  /"class-code" = </ && cls == "" { v = $0; sub(/.*= </, "", v); cls = substr(v, 5, 2) substr(v, 3, 2) substr(v, 1, 2) }
  END { flush() }'
print
print "Input: $(print -n /dev/usb_hid_*(N) /dev/clokeos_*(N)) $(ioreg -c ApplePS2Keyboard -d 1 2>/dev/null | grep -q ApplePS2Keyboard && print -n 'PS/2-keyboard ')$(ioreg -c ApplePS2MouseDevice -d 1 2>/dev/null | grep -q ApplePS2MouseDevice && print -n 'PS/2-mouse-port(no driver)')"
print "USB devices (xHCI): $(dmesg 2>/dev/null | sed -n -E 's/.*(slot [0-9]+).*class=([0-9a-f]+).*vid=([0-9a-f]+) pid=([0-9a-f]+).*/\1 \3:\4 class \2,/p' | sort -u | tr '\n' ' ')"
net=""
for i in en0 en1 en2 en3; do a=$(ipconfig getifaddr $i 2>/dev/null); [[ -n $a ]] && net+="$i $a  "; done
print "Network: ${net:-no address}"
print
print "Kernel messages (USB, HID, PS/2):"
dmesg 2>/dev/null | grep -i -E 'xhci|ehci|uhci|ohci|usb|hid|ps2|8042' |
  grep -v -E 'armed|checkpoint|DMA |DCBAA|Paired port|Extended Cap|HCSPARAMS|BAR|assigned-addresses' | tail -12 | cut -c1-150
print
print "Xorg:"
grep -E 'usb_hid|puredarwininput|\(EE\)' /var/log/Xorg.0.log 2>/dev/null | tail -5 | cut -c1-150
