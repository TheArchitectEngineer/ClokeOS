#!/bin/zsh
# Diagnose für Rechner, an denen Tastatur oder Maus nicht gehen: zeigt in einem Fenster, was ClokeOS
# von der Hardware sieht, zum Abfotografieren. cloakserver-session startet es, wenn 45 Sekunden nach
# dem Start weder /dev/usb_hid_kbd noch /dev/usb_hid_mouse da sind; Xorg liest Eingaben nur von dort
# (puredarwininput), eingebaute PS/2-Tastaturen und Touchpads von Notebooks erreichen es nicht.
#   clokeos-diag          Bericht ausgeben
PATH=/bin:/sbin:/usr/bin:/usr/sbin
. /etc/clokeos-release 2>/dev/null
prop() { # Zeichenkette aus ioreg: "name" = <"Wert"> oder "name" = "Wert"
  sed -n -E "s/.*\"$1\" = <?\"([^\"]*)\".*/\1/p" | head -1
}
pe=$(ioreg -c IOPlatformExpertDevice -d 2 -w 0 2>/dev/null)
print "ClokeOS ${VERSION:-?} ($(uname -m)) diagnostics - please take a photo of this window."
print "Model: $(print -r -- $pe | prop manufacturer) $(print -r -- $pe | prop product-name) $(print -r -- $pe | prop model)  RAM: $(( $(sysctl -n hw.memsize) / 1048576 )) MB  boot-args: $(sysctl -n kern.bootargs 2>/dev/null | cut -c1-60)"
print "PCI (USB, I2C/serial, SMBus, storage, network; vendor:device class -> driver):"
ioreg -r -c IOPCIDevice -d 2 -l -w 0 2>/dev/null | awk '
  function le16(s) { return substr(s, 3, 2) substr(s, 1, 2) }
  function flush() { if (name != "" && cls ~ /^(0c03|0c80|0c05|0106|0108|0200|0280)/) printf "  %-22s %s:%s %s -> %s\n", name, vid, did, cls, (drv == "" ? "NO DRIVER" : drv) }
  /\+-o .*<class IOPCIDevice/ { flush(); name = $0; sub(/.*\+-o /, "", name); sub(/ .*/, "", name); vid = did = cls = drv = ""; next }
  /\+-o / { if (drv == "") { d = $0; sub(/.*\+-o /, "", d); sub(/ .*/, "", d); drv = d }; next }
  /"vendor-id" = </ && vid == "" { v = $0; sub(/.*= </, "", v); vid = le16(v) }
  /"device-id" = </ && did == "" { v = $0; sub(/.*= </, "", v); did = le16(v) }
  /"class-code" = </ && cls == "" { v = $0; sub(/.*= </, "", v); cls = substr(v, 5, 2) substr(v, 3, 2) substr(v, 1, 2) }
  END { flush() }'
drv=""
for c in ClokePS2 ApplePS2Controller ApplePS2Keyboard ClokeI2CHID IOUSBHIDDriver; do
  n=$(ioreg -r -c $c -d 1 -w 0 2>/dev/null | grep -c "<class $c")
  (( n )) && drv+="$c x$n  "
done
print "Drivers: ${drv:-none}  devices: $(print -n /dev/usb_hid_*(N) /dev/clokeos_*(N))"
net=""
for i in en0 en1 en2 en3; do a=$(ipconfig getifaddr $i 2>/dev/null); [[ -n $a ]] && net+="$i $a  "; done
print "Network: ${net:-no address}"
print "CPUs: hw.ncpu=$(sysctl -n hw.ncpu 2>/dev/null) physical=$(sysctl -n hw.physicalcpu 2>/dev/null)"
dmesg 2>/dev/null | grep -E 'ClokeTrace|Started cpu' | tail -24 | cut -c1-148
dmesg 2>/dev/null | grep -E 'ClokeRtw88' | tail -12 | cut -c1-148
print "Kernel (ClokePS2, ClokeI2CHID, PS/2, HID):"
dmesg 2>/dev/null | grep -E 'Cloke|PS2|IOUSBHID' | grep -v ClokeTrace | tail -16 | cut -c1-148
print "Disk and USB errors:"
dmesg 2>/dev/null | grep -i -E 'nvme|I/O error|timed out|timeout|abort|xhci.*(error|fail|stall)|usb.*(error|fail|stall|reset)' | grep -v -E 'armed|checkpoint' | tail -8 | cut -c1-148
print "Installer log:"
tail -6 /var/tmp/installer.log 2>/dev/null | cut -c1-148
print "Xorg input:"
grep -E 'Keyboard[0-9]|Mouse[0-9]|\(EE\)' /var/log/Xorg.0.log 2>/dev/null | grep -E 'cannot|Couldn|EE|acquired|Adding' | tail -7 | cut -c1-148
