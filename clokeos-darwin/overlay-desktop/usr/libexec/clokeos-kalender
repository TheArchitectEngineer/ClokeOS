#!/usr/bin/python3
"""Kalender aus dem Dock: voriger, dieser und nächster Monat, heute hervorgehoben. Englisch mit
Wochenbeginn Sonntag, mit /etc/clokeos-language = de deutsch mit Wochenbeginn Montag."""
import calendar
import datetime

try:
    with open('/etc/clokeos-language') as f:
        DE = f.read().strip().startswith('de')
except OSError:
    DE = False

if DE:
    MONTHS = ['Januar', 'Februar', 'März', 'April', 'Mai', 'Juni', 'Juli', 'August', 'September',
              'Oktober', 'November', 'Dezember']
    DAYS, FIRST = 'Mo Di Mi Do Fr Sa So', 0
    WEEKDAYS = ['Montag', 'Dienstag', 'Mittwoch', 'Donnerstag', 'Freitag', 'Samstag', 'Sonntag']
    CLOSE = 'Eingabetaste schließt den Kalender. '
else:
    MONTHS = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September',
              'October', 'November', 'December']
    DAYS, FIRST = 'Su Mo Tu We Th Fr Sa', 6
    WEEKDAYS = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday']
    CLOSE = 'Press Return to close the calendar. '
TODAY = '\033[7m%2d\033[0m'
WIDTH = 20


def month(year, mon, today):
    lines = [('%s %d' % (MONTHS[mon - 1], year)).center(WIDTH), DAYS]
    for week in calendar.Calendar(FIRST).monthdayscalendar(year, mon):
        cells = []
        for day in week:
            if not day:
                cells.append('  ')
            elif (year, mon, day) == today:
                cells.append(TODAY % day)
            else:
                cells.append('%2d' % day)
        lines.append(' '.join(cells))
    while len(lines) < 8:
        lines.append('')
    return lines


def visible(s):
    return len(s.replace('\033[7m', '').replace('\033[0m', ''))


d = datetime.date.today()
today = (d.year, d.month, d.day)
months = []
for delta in (-1, 0, 1):
    m = d.month + delta
    y = d.year + (m - 1) // 12
    months.append(month(y, (m - 1) % 12 + 1, today))
wd = WEEKDAYS[d.weekday()]
if DE:
    head = '%s, %d. %s %d' % (wd, d.day, MONTHS[d.month - 1], d.year)
else:
    head = '%s, %s %d, %d' % (wd, MONTHS[d.month - 1], d.day, d.year)
print('\n  \033[1m%s\033[0m\n' % head)
for line in zip(*months):
    print('  ' + '   '.join(z + ' ' * (WIDTH - visible(z)) for z in line))
try:
    input('\n  ' + CLOSE)
except EOFError:
    pass
