#!/bin/zsh
# Läuft unter xinit: richtet die Sitzung ein und startet CloakServer mit einem D-Bus für die Sitzung.
. /etc/profile
[[ -r /etc/clokeos-release ]] && . /etc/clokeos-release
export TZ=${TIMEZONE:-UTC}
export XDG_CONFIG_DIRS=/etc/xdg:/etc
# App-Defaults der X-Programme (xcalc, xclock) liegen bei PureDarwin unter /share/X11.
export XFILESEARCHPATH=/share/X11/%T/%N%C%S:/share/X11/%T/%N%S:/usr/share/X11/%T/%N%S
export XUSERFILESEARCHPATH=$HOME/%N%C:$HOME/%N
print '*customization: -color' | /bin/xrdb -nocpp -merge
# arm64: PureDarwins GTK sucht die Xcursor-Funktionen in den geladenen Bibliotheken, lädt aber
# keine libXcursor (siehe cloakserver/build.sh). Für CloakServer und alle Programme der Sitzung:
[[ $(uname -m) == arm64 && -r /lib/libXcursor.1.dylib ]] && export DYLD_INSERT_LIBRARIES=/lib/libXcursor.1.dylib${DYLD_INSERT_LIBRARIES:+:$DYLD_INSERT_LIBRARIES}  # dahinter bleiben die Haken aus /etc/profile (libclokeos-mime, libxlat-exec)
# arm64 hat keine Echtzeituhr; com.clokeos.network stellt die Uhr erst nach dem Netzwerkstart,
# ungefähr wenn Xorg bereit ist. Damit die Anmeldung nicht kurz 1970 und das Nachtbild zeigt,
# wartet CloakServer höchstens 5 Sekunden darauf (Xorg startet unterdessen schon).
for i in {1..10}; do
  (( $(date +%Y) >= 2020 )) && break
  sleep 0.5
done
# Globale Menüleiste: appmenu-gtk-module gibt die Menüs der GTK-Programme an CloakServer, das sie
# oben in der Leiste zeigt (menubar/). Ohne das Modul bleiben sie wie bisher im Fenster.
# GTK_PATH: PureDarwins GTK sucht Module sonst unter seinem Pfad aus dem Nix-Build, nicht in /lib.
if [[ -r /lib/gtk-3.0/modules/libappmenu-gtk-module.so ]]; then
  export GTK_PATH=/lib/gtk-3.0 GTK_MODULES=appmenu-gtk-module
fi
cd $HOME
# Xorg liest Tastatur und Maus von USB (/dev/usb_hid_kbd, /dev/usb_hid_mouse, nur wenn sie beim Start
# stecken) und vom PS/2-Controller (/dev/clokeos_kbd, /dev/clokeos_mouse, kext/ClokePS2). Fehlt nach
# 45 Sekunden jede Tastatur oder jede Maus, zeigt ein Fenster, was ClokeOS von der Hardware sieht
# (clokeos-diag), zum Abfotografieren: ohne Eingabe gibt es sonst keinen Weg zu den Meldungen, und
# die Wiederherstellung vom USB-Stick hat kein SSH.
# Mit D beim Einschalten (Loader: clokeos_diag=1) kommt das Fenster gleich und immer, alle 20 Sekunden
# neu gezeichnet. Vom USB-Stick (rd=md0) kommt es auch von selbst, wenn nach 60 Sekunden weder ein
# Tastatur-Byte noch ein Touchpad-Bericht angekommen ist (Geräte erkannt, aber ohne Reaktion), und die
# Diagnose landet alle 30 Sekunden in ClokeOS/diag.txt auf dem Stick (clokeos-installer stick-write),
# zum Lesen am Mac ohne Foto.
diag_window() {
  /bin/xfce4-terminal --disable-server --title="ClokeOS Diagnostics" --geometry=150x46 --hold \
    -x /bin/zsh -c 'while true; do clear; /usr/libexec/clokeos-diag; sleep 20; done'
}
no_input() { # keine Maus und kein Touchpad hat bisher etwas gemeldet (Tastatur allein genügt nicht)
  [[ ! -e /dev/usb_hid_mouse ]] &&
    ! dmesg 2>/dev/null | grep -q -E 'ClokePS2: mouse byte|ClokeI2CHID: first input report'
}
bootargs=$(sysctl -n kern.bootargs 2>/dev/null)
if [[ -x /usr/libexec/clokeos-diag && -x /bin/xfce4-terminal ]]; then
  if [[ $bootargs == *clokeos_diag=1* ]]; then
    ( sleep 15; diag_window ) &!
  elif [[ $bootargs == *rd=md0* ]]; then
    ( sleep 60; no_input && diag_window ) &!
  else
    ( sleep 45
      [[ ( -e /dev/usb_hid_kbd || -e /dev/clokeos_kbd ) && ( -e /dev/usb_hid_mouse || -e /dev/clokeos_mouse || -e /dev/clokeos_touchpad ) ]] ||
        diag_window ) &!
  fi
  if [[ $bootargs == *rd=md0* && -x /usr/libexec/clokeos-installer ]]; then
    ( sleep 20
      while true; do
        /usr/libexec/clokeos-diag > /var/tmp/clokeos-diag.txt 2>&1
        /usr/libexec/clokeos-installer stick-write diag.txt /var/tmp/clokeos-diag.txt > /var/tmp/clokeos-diag.log 2>&1
        sleep 30
      done ) &!
  fi
fi
cs=/System/Library/CoreServices/CloakServer/CloakServer
# dbus-run-session statt dbus-launch: PureDarwins dbus-launch startet auf arm64 nicht.
[[ -x /bin/dbus-run-session ]] && exec /bin/dbus-run-session -- $cs
exec $cs
