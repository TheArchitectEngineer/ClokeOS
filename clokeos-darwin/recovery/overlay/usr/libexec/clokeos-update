#!/bin/zsh
# clokeos-update: bringt ein installiertes ClokeOS auf die Version dieses Mediums (Installationsstick),
# ohne Neuinstallation. Dateien und Einstellungen der Benutzer bleiben.
#
# Die EFI-Partition der installierten Platte (Loader, Kernel mit allen Treibern, Boot-Argumente und das
# Update-Paket update.xz) wird neu geschrieben (clokeos-installer update-esp); die Kennungen der Partitionen
# bleiben. Beim nächsten Start legt clokeos-apply-update (vor CloakServer) die Programme und die Oberfläche
# aus dem Paket auf das System. Das System selbst lässt sich hier nicht einbinden (ext4 würde den Kernel
# abstürzen lassen). Gilt ab Systemen, die clokeos-apply-update schon haben (ClokeOS 2.4 und neuer);
# ältere müssen einmal neu installiert werden.
#
# Läuft in der Wiederherstellung (Option "ClokeOS aktualisieren") oder im Terminal als root.
emulate -L zsh
setopt NO_BANG_HIST
INSTALLER=/usr/libexec/clokeos-installer
de=0; [[ $(cat /etc/clokeos-language 2>/dev/null) == de* ]] && de=1
t() { (( de )) && print -r -- "$2" || print -r -- "$1"; }
say() { print -P "%B==> $*%b" }
die() { print -P "%F{red}$*%f"; print -n "$(t 'Press Return to close.' 'Eingabetaste schließt das Fenster.') "; read -r _; exit 1 }

[[ $EUID == 0 ]] || die "$(t 'This needs root.' 'Dafür sind Administratorrechte nötig.')"
arch=$(uname -m); [[ $arch == arm64* ]] || arch=x86_64

say "$(t 'Looking for an installed ClokeOS' 'Suche ein installiertes ClokeOS')"
disk=""
typeset -A flags
while read -r kind a b c d; do
  if [[ $kind == DISK ]]; then flags[$a]=$c
  elif [[ $kind == PART && -n ${flags[$a]:-} && ${flags[$a]} == *c* && ${flags[$a]} != *i* && $d == ClokeOS ]]; then
    disk=$a
  fi
done < <($INSTALLER disks 2>/dev/null)
[[ -n $disk ]] || die "$(t 'No installed ClokeOS found on this computer.' 'Auf diesem Rechner wurde kein installiertes ClokeOS gefunden.')"
print "  $disk"

# Quelle: wie die Installation (CLOKEOS_UPDATE_BASE zum Testen: Adresse eines Release-Ordners)
base="${CLOKEOS_UPDATE_BASE:-}"
if [[ -n $base ]]; then :
elif [[ -f /Library/ClokeOS/Install/clokeos-$arch.txt ]]; then base="file:///Library/ClokeOS/Install"
elif $INSTALLER stick 2>/dev/null | grep -q '^STICK '; then base="stick:"
else base=$(sed -n 's/^RELEASES="\(.*\)"/\1/p' /etc/clokeos-recovery 2>/dev/null | head -1)
fi
[[ -n $base ]] || die "$(t 'No update source (installer stick or internet).' 'Keine Quelle für das Update (Installationsstick oder Internet).')"

say "$(t 'Updating the startup volume (loader, kernel, files for the system)' 'Aktualisiere das Startvolume (Loader, Kernel, Dateien für das System)')"
if [[ ${1:-} == -n ]]; then
  print "$(t 'Dry run: would write the startup volume of' 'Probelauf: würde das Startvolume schreiben von') $disk ($base)"
  exit 0
fi
$INSTALLER update-esp $disk $base 2>&1 | while read -r line; do
  case $line in
    STEP*) print "  ${line#STEP }" ;;
    ERROR*) print -P "%F{red}${line#ERROR }%f" ;;
  esac
done
rc=${pipestatus[1]}
(( rc == 0 )) || die "$(t 'The startup volume could not be updated.' 'Das Startvolume ließ sich nicht aktualisieren.')"

say "$(t 'Done. Restart the computer: the new files are applied during the next start.' 'Fertig. Starte den Rechner neu: Die neuen Dateien werden beim nächsten Start angewendet.')"
print -n "$(t 'Press Return to close.' 'Eingabetaste schließt das Fenster.') "
read -r _
