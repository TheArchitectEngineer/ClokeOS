+static EFI_STATUS clokeos_load_ramdisk(AppContext *ctx) {
+  EFI_FILE_PROTOCOL *root = NULL;
+  if (EFI_ERROR(app_open_self_volume(ctx, &root)))
+    return EFI_SUCCESS;
+  static CONST CHAR16 *const names[] = {L"\\ramdisk.img", L"\\ramdisk-lite.img"};
+  BOOLEAN any = FALSE;
+  EFI_STATUS status = EFI_NOT_FOUND;
+  for (UINTN i = 0; i < sizeof names / sizeof names[0]; i++) {
+    status = clokeos_try_ramdisk(ctx, root, names[i]);
+    if (status != EFI_NOT_FOUND)
+      any = TRUE;
+    if (!EFI_ERROR(status)) {
+      g_rd_lite = i == 1;
+      break;
+    }
+  }
+  uefi_call_wrapper(root->Close, 1, root);
+  if (!any)
+    return EFI_SUCCESS; /* the usual case: no RAMDisk */
+  return EFI_ERROR(status) ? EFI_OUT_OF_RESOURCES : EFI_SUCCESS;
+}
