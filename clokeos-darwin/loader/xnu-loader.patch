+/* Upper bound on keys read per look, so other keys arriving as fast as they
+ * are read (auto-repeat) cannot keep the loop going. */
+#define VERBOSE_KEY_MAX_READS 64
+
+/* TRUE if v or V is among the keys already queued in ConIn. Never waits; the
+ * keys it reads are used up. */
+static BOOLEAN verbose_key_pressed(AppContext *ctx) {
+  EFI_INPUT_KEY key;
+
+  if (!ctx->st->ConIn)
+    return FALSE;
+
+  for (UINTN i = 0; i < VERBOSE_KEY_MAX_READS; i++) {
+    if (EFI_ERROR(uefi_call_wrapper(ctx->st->ConIn->ReadKeyStroke, 2, ctx->st->ConIn, &key)))
+      return FALSE;
+    if (key.UnicodeChar == L'v' || key.UnicodeChar == L'V')
+      return TRUE;
+  }
+  return FALSE;
+}
+
+/*
+ * ClokeOS: V pressed during start-up turns a quiet boot into a verbose one,
+ * as if -v gopconsole=1 were in boot-args.txt (the boot screen of
+ * clokeos.html offers the same key). With -v boot_fill_video hands the kernel
+ * the framebuffer as a text console, and gopconsole=1 keeps it one once
+ * IOGOPFramebuffer starts. The loader log comes back to the screen, which is
+ * cleared first so the log does not run over the boot logo.
+ * The firmware empties ConIn just before it starts the loader (EDK2's BDS
+ * reads all keys for its hotkeys), and the loader is done within a fraction
+ * of a second, so in practice V has to be held down while the machine
+ * starts; its auto-repeat reaches one of the two looks in efi_main.
+ */
+static EFI_STATUS verbose_boot_on_key(
+    AppContext *ctx, const CHAR8 **cmdline, BOOLEAN *owned) {
+  const CHAR8 suffix[] = " -v gopconsole=1";
+  UINTN len = 0;
+  CHAR8 *copy = NULL;
+
+  if (boot_cmdline_has_flag(*cmdline, (const CHAR8 *)"-v") || !verbose_key_pressed(ctx))
+    return EFI_SUCCESS;
+
+  while ((*cmdline)[len] != '\0')
+    len++;
+  EFI_STATUS status = app_alloc_pool(ctx, len + sizeof(suffix), (VOID **)&copy);
+  if (EFI_ERROR(status))
+    return status;
+
+  CopyMem(copy, *cmdline, len);
+  CopyMem(copy + len, suffix, sizeof(suffix));
+  if (*owned)
+    app_free_pool(ctx, (VOID *)(UINTN)*cmdline);
+  *cmdline = copy;
+  *owned = TRUE;
+
+  console_set_quiet(FALSE);
+  if (ctx->st->ConOut) {
+    uefi_call_wrapper(ctx->st->ConOut->ClearScreen, 1, ctx->st->ConOut);
+    uefi_call_wrapper(ctx->st->ConOut->EnableCursor, 2, ctx->st->ConOut, TRUE);
+  }
+  log_info(L"key V: verbose boot, using \"%a\"\r\n", *cmdline);
+  return EFI_SUCCESS;
+}
