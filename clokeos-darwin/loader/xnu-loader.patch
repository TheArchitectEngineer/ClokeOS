+/* Upper bound on keys read per look, so other keys arriving as fast as they
+ * are read (auto-repeat) cannot keep the loop going. */
+#define VERBOSE_KEY_MAX_READS 64
+
+/* Keys seen so far: V (verbose boot) and R (recovery). Reading uses keys up,
+ * so one look records both. */
+static BOOLEAN g_key_v, g_key_r;
+
+/* Reads the keys already queued in ConIn. Never waits. */
+static VOID scan_boot_keys(AppContext *ctx) {
+  EFI_INPUT_KEY key;
+
+  if (!ctx->st->ConIn)
+    return;
+
+  for (UINTN i = 0; i < VERBOSE_KEY_MAX_READS; i++) {
+    if (EFI_ERROR(uefi_call_wrapper(ctx->st->ConIn->ReadKeyStroke, 2, ctx->st->ConIn, &key)))
+      return;
+    if (key.UnicodeChar == L'v' || key.UnicodeChar == L'V')
+      g_key_v = TRUE;
+    if (key.UnicodeChar == L'r' || key.UnicodeChar == L'R')
+      g_key_r = TRUE;
+  }
+}
+
+static BOOLEAN verbose_key_pressed(AppContext *ctx) {
+  scan_boot_keys(ctx);
+  return g_key_v;
+}
+
+/*
+ * ClokeOS: R held during start-up boots the recovery partition, like Cmd+R on
+ * a Mac. clokeos-installer writes boot-args-recovery.txt next to
+ * boot-args.txt; its boot-uuid= names the recovery partition. Without that
+ * file (a disk not set up by the installer) R does nothing.
+ */
+static BOOLEAN g_recovery_done;
+
+static EFI_STATUS recovery_boot_on_key(AppContext *ctx, const CHAR8 **cmdline, BOOLEAN *owned) {
+  if (g_recovery_done)
+    return EFI_SUCCESS;
+  scan_boot_keys(ctx);
+  if (!g_key_r)
+    return EFI_SUCCESS;
+  g_recovery_done = TRUE;
+
+  FileBuffer file = {0};
+  EFI_STATUS status = file_read_all_from_any_volume(ctx, L"\\EFI\\BOOT\\boot-args-recovery.txt", &file, NULL);
+  if (EFI_ERROR(status) || file.size == 0) {
+    log_info(L"key R: no boot-args-recovery.txt (%r)\r\n", status);
+    return EFI_SUCCESS;
+  }
+  UINTN len = file.size;
+  CHAR8 *bytes = (CHAR8 *)file.data;
+  if (bytes[0] == '#') { /* the installer had no recovery to put on this disk */
+    log_info(L"key R: this disk has no recovery partition\r\n");
+    file_free(ctx, &file);
+    return EFI_SUCCESS;
+  }
+  while (len > 0 && (bytes[len - 1] == '\n' || bytes[len - 1] == '\r' || bytes[len - 1] == ' ' || bytes[len - 1] == '\t'))
+    len--;
+  CHAR8 *copy = NULL;
+  status = app_alloc_pool(ctx, len + 1, (VOID **)&copy);
+  if (!EFI_ERROR(status)) {
+    CopyMem(copy, bytes, len);
+    copy[len] = '\0';
+    if (*owned)
+      app_free_pool(ctx, (VOID *)(UINTN)*cmdline);
+    *cmdline = copy;
+    *owned = TRUE;
+    log_info(L"key R: recovery, using \"%a\"\r\n", *cmdline);
+  }
+  file_free(ctx, &file);
+  return status;
+}
+
+/*
+ * ClokeOS: V pressed during start-up turns a quiet boot into a verbose one,
+ * as if -v gopconsole=1 were in boot-args.txt (the boot screen of
+ * clokeos.html offers the same key). With -v boot_fill_video hands the kernel
+ * the framebuffer as a text console, and gopconsole=1 keeps it one once
+ * IOGOPFramebuffer starts. The loader log comes back to the screen, which is
+ * cleared first so the log does not run over the boot logo.
+ * The firmware empties ConIn just before it starts the loader (EDK2's BDS
+ * reads all keys for its hotkeys), and the loader is done within a fraction
+ * of a second, so in practice V has to be held down while the machine
+ * starts; its auto-repeat reaches one of the two looks in efi_main.
+ */
+static EFI_STATUS verbose_boot_on_key(
+    AppContext *ctx, const CHAR8 **cmdline, BOOLEAN *owned) {
+  const CHAR8 suffix[] = " -v gopconsole=1";
+  UINTN len = 0;
+  CHAR8 *copy = NULL;
+
+  if (boot_cmdline_has_flag(*cmdline, (const CHAR8 *)"-v") || !verbose_key_pressed(ctx))
+    return EFI_SUCCESS;
+
+  while ((*cmdline)[len] != '\0')
+    len++;
+  EFI_STATUS status = app_alloc_pool(ctx, len + sizeof(suffix), (VOID **)&copy);
+  if (EFI_ERROR(status))
+    return status;
+
+  CopyMem(copy, *cmdline, len);
+  CopyMem(copy + len, suffix, sizeof(suffix));
+  if (*owned)
+    app_free_pool(ctx, (VOID *)(UINTN)*cmdline);
+  *cmdline = copy;
+  *owned = TRUE;
+
+  console_set_quiet(FALSE);
+  if (ctx->st->ConOut) {
+    uefi_call_wrapper(ctx->st->ConOut->ClearScreen, 1, ctx->st->ConOut);
+    uefi_call_wrapper(ctx->st->ConOut->EnableCursor, 2, ctx->st->ConOut, TRUE);
+  }
+  log_info(L"key V: verbose boot, using \"%a\"\r\n", *cmdline);
+  return EFI_SUCCESS;
+}
+
+/*
+ * ClokeOS: RAMDisk from the boot volume (\ramdisk.img, an ext4 root) for the
+ * USB installer. The kernel has no USB mass storage driver, so it cannot
+ * mount a root on the stick; the firmware can read it, though.
+ *
+ * IOFindBSDRoot reaches the RAMDisk through ml_static_ptovirt, which only
+ * works for [0, physfree): the range XNU's bootstrap page tables map and
+ * never hands out as free memory. physfree = kaddr + ksize, and boot.c grows
+ * ksize over the runtime-services window anyway. So the image goes to a fixed
+ * low address right above the boot-info block (loader data is fine there),
+ * boot.c starts the runtime window behind it, and everything has to end below
+ * the edge of the bootstrap page tables (CLOKEOS_RAMDISK_LIMIT, NKPT). That
+ * caps the image at roughly 900 MB.
+ *
+ * The device tree gets /chosen/memory-map/RAMDisk and the boot-args rd=md0;
+ * IOFindBSDRoot then mounts md0 as the root.
+ */
+/* Largest free stretch found and size needed, for the message when nothing fits */
+static UINT64 g_rd_largest, g_rd_needed;
+
+/* The lowest free stretch of the firmware's memory map that starts above the
+ * boot-info block and ends early enough to leave room for the runtime window
+ * below the limit. Every firmware lays out low memory differently. */
+static EFI_STATUS clokeos_place_ramdisk(AppContext *ctx, UINTN pages, EFI_PHYSICAL_ADDRESS *out) {
+  UINT64 bytes = (UINT64)pages << EFI_PAGE_SHIFT;
+  EFI_STATUS status = EFI_OUT_OF_RESOURCES;
+  UINTN map_size = 0, key = 0, desc_size = 0;
+  UINT32 desc_ver = 0;
+  UINT8 *map = NULL;
+  uefi_call_wrapper(ctx->bs->GetMemoryMap, 5, &map_size, NULL, &key, &desc_size, &desc_ver);
+  map_size += 16 * desc_size;
+  if (EFI_ERROR(app_alloc_pool(ctx, map_size, (VOID **)&map)))
+    return status;
+  if (!EFI_ERROR(uefi_call_wrapper(ctx->bs->GetMemoryMap, 5, &map_size, (EFI_MEMORY_DESCRIPTOR *)map, &key,
+                                   &desc_size, &desc_ver))) {
+    /* the runtime window behind the image needs room for every runtime region */
+    UINT64 rt_bytes = 0;
+    for (UINTN off = 0; off + desc_size <= map_size; off += desc_size) {
+      EFI_MEMORY_DESCRIPTOR *d = (EFI_MEMORY_DESCRIPTOR *)(map + off);
+      if (d->Attribute & EFI_MEMORY_RUNTIME)
+        rt_bytes += (UINT64)d->NumberOfPages << EFI_PAGE_SHIFT;
+    }
+    UINT64 top = CLOKEOS_RAMDISK_LIMIT - ((rt_bytes + CLOKEOS_RAMDISK_RT_RESERVE + 0x1FFFFFULL) & ~0x1FFFFFULL);
+    log_info(L"ramdisk: runtime regions 0x%lx bytes, image must end below 0x%lx\r\n", rt_bytes, top);
+    UINT64 best = 0;
+    for (UINTN off = 0; off + desc_size <= map_size; off += desc_size) {
+      EFI_MEMORY_DESCRIPTOR *d = (EFI_MEMORY_DESCRIPTOR *)(map + off);
+      if (d->Type != EfiConventionalMemory)
+        continue;
+      UINT64 start = d->PhysicalStart, end = start + ((UINT64)d->NumberOfPages << EFI_PAGE_SHIFT);
+      if (start < CLOKEOS_RAMDISK_BASE)
+        start = CLOKEOS_RAMDISK_BASE;
+      start = (start + EFI_PAGE_SIZE - 1) & ~(UINT64)(EFI_PAGE_SIZE - 1);
+      if (end > top)
+        end = top;
+      if (end > start && end - start > g_rd_largest)
+        g_rd_largest = end - start;
+      if (end > start && end - start >= bytes && (best == 0 || start < best))
+        best = start;
+      if (d->PhysicalStart < 0x40000000ULL && d->NumberOfPages >= 256)
+        log_info(L"ramdisk: free 0x%lx-0x%lx\r\n", d->PhysicalStart,
+                 d->PhysicalStart + ((UINT64)d->NumberOfPages << EFI_PAGE_SHIFT));
+    }
+    if (best != 0) {
+      *out = best;
+      status = uefi_call_wrapper(ctx->bs->AllocatePages, 4, AllocateAddress, EfiLoaderData, pages, out);
+    }
+  }
+  app_free_pool(ctx, map);
+  return status;
+}
+
+/* One image: EFI_NOT_FOUND without the file, EFI_OUT_OF_RESOURCES when it does
+ * not fit, EFI_SUCCESS when loaded (ctx->ramdisk_*) */
+static EFI_STATUS clokeos_try_ramdisk(AppContext *ctx, EFI_FILE_PROTOCOL *root, CONST CHAR16 *name) {
+  EFI_FILE_PROTOCOL *file = NULL;
+  UINTN size = 0;
+  EFI_STATUS status = file_open(root, name, EFI_FILE_MODE_READ, 0, &file);
+  if (EFI_ERROR(status))
+    return EFI_NOT_FOUND;
+  status = file_get_size(file, &size);
+  if (EFI_ERROR(status) || size == 0) {
+    uefi_call_wrapper(file->Close, 1, file);
+    return EFI_NOT_FOUND;
+  }
+  UINTN pages = (size + EFI_PAGE_SIZE - 1) >> EFI_PAGE_SHIFT;
+  if (g_rd_needed == 0 || (UINT64)size < g_rd_needed)
+    g_rd_needed = size;
+  EFI_PHYSICAL_ADDRESS addr = 0;
+  status = clokeos_place_ramdisk(ctx, pages, &addr);
+  if (EFI_ERROR(status)) {
+    log_info(L"%s: no room for %lu MiB below 0x%lx\r\n", name, (UINT64)(size >> 20), (UINT64)CLOKEOS_RAMDISK_LIMIT);
+    uefi_call_wrapper(file->Close, 1, file);
+    return EFI_OUT_OF_RESOURCES;
+  }
+  log_info(L"%s: reading %lu MiB to 0x%lx\r\n", name, (UINT64)(size >> 20), (UINT64)addr);
+  UINT8 *dst = (UINT8 *)(UINTN)addr;
+  UINTN done_bytes = 0, step = 16u << 20;
+  while (done_bytes < size) {
+    UINTN n = size - done_bytes < step ? size - done_bytes : step;
+    status = uefi_call_wrapper(file->Read, 3, file, &n, dst + done_bytes);
+    if (EFI_ERROR(status) || n == 0)
+      break;
+    done_bytes += n;
+    if ((done_bytes & ((256u << 20) - 1)) < step)
+      log_info(L"%s: %lu MiB\r\n", name, (UINT64)(done_bytes >> 20));
+  }
+  uefi_call_wrapper(file->Close, 1, file);
+  if (done_bytes != size) {
+    log_error(L"%s: read %lu of %lu bytes (%r)\r\n", name, (UINT64)done_bytes, (UINT64)size, status);
+    uefi_call_wrapper(ctx->bs->FreePages, 2, addr, pages);
+    return EFI_DEVICE_ERROR;
+  }
+  ctx->ramdisk_phys = addr;
+  ctx->ramdisk_size = (UINT64)pages << EFI_PAGE_SHIFT;
+  log_info(L"%s: RAMDisk phys=0x%lx size=0x%lx\r\n", name, (UINT64)addr, ctx->ramdisk_size);
+  return EFI_SUCCESS;
+}
+
+/* \ramdisk.img brings the system along (install without internet); when it
+ * does not fit (computers with 1 GB RAM), \ramdisk-lite.img has only the
+ * recovery, which then downloads the system. Neither file: no RAMDisk. */
+/* ClokeOS: started from the USB installer, the firmware often brings up only
+ * the boot device. PureDarwin's SATA driver (RavynAHCIPort) reads each port's
+ * device signature before it lets the port receive FISes, so on a port the
+ * firmware never touched it sees 0xffffffff and skips the disk. Connecting
+ * every driver once, as the UEFI shell's "connect -r" does, has the firmware
+ * initialise all ports, which leaves valid signatures behind. */
+static VOID clokeos_connect_all(AppContext *ctx) {
+  UINTN n = 0;
+  EFI_HANDLE *handles = NULL;
+  EFI_STATUS st = uefi_call_wrapper(ctx->bs->LocateHandleBuffer, 5, AllHandles, NULL, NULL, &n, &handles);
+  if (EFI_ERROR(st)) {
+    log_error(L"connect all: no handle list (%r)\r\n", st);
+    return;
+  }
+  for (UINTN i = 0; i < n; i++)
+    uefi_call_wrapper(ctx->bs->ConnectController, 4, handles[i], NULL, NULL, TRUE);
+  uefi_call_wrapper(ctx->bs->FreePool, 1, handles);
+  log_info(L"connect all: %lu handles\r\n", (UINT64)n);
+}
